// Dev container: reeky-horror (Roblox · Rojo · Luau · Claude Code)
// Details and security model: .devcontainer/README.md
{
  "name": "reeky-horror 👻 (Roblox · Rojo · Claude Code)",

  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "TZ": "Europe/Berlin",
      "CLAUDE_CODE_VERSION": "latest",
      "ROKIT_VERSION": "1.2.0"
    }
  },

  // Keep the image ENTRYPOINT (firewall setup as root) + CMD (sleep infinity).
  "overrideCommand": false,
  // tini as PID 1 (zombie reaping, clean signal handling)
  "init": true,

  // Container process = root (firewall only); all work happens as "dev".
  "containerUser": "root",
  "remoteUser": "dev",

  // ---------------------------------------------------------------------------
  //  Least privilege
  // ---------------------------------------------------------------------------
  "runArgs": [
    // Drop all capabilities, add back only what's needed:
    "--cap-drop=ALL",
    "--cap-add=NET_ADMIN",        // iptables/ipset (firewall) + dnsmasq ipset
    "--cap-add=NET_RAW",          // iptables extensions
    "--cap-add=NET_BIND_SERVICE", // dnsmasq on port 53
    "--cap-add=SETUID",           // dnsmasq drops to user "dnsfw"
    "--cap-add=SETGID",
    "--cap-add=CHOWN",            // file permissions in entrypoint / volume init
    "--cap-add=DAC_OVERRIDE",
    "--cap-add=FOWNER",
    "--cap-add=KILL",             // restarting dnsmasq on firewall re-init
    // No way back to root (setuid/file caps have no effect; the image has no sudo)
    "--security-opt=no-new-privileges:true",
    // IPv6 off – the firewall only handles IPv4
    "--sysctl=net.ipv6.conf.all.disable_ipv6=1",
    "--sysctl=net.ipv6.conf.default.disable_ipv6=1",
    // Ports < 1024 require a capability (dev can't bind e.g. a fake DNS on :53)
    "--sysctl=net.ipv4.ip_unprivileged_port_start=1024",
    "--pids-limit=4096"
  ],

  // ---------------------------------------------------------------------------
  //  File system: ONLY the project folder + two named volumes
  //  (no Docker socket, no ~/.ssh, no host credentials)
  // ---------------------------------------------------------------------------
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "mounts": [
    // Container config is READ-ONLY inside the container -> Claude can't grant
    // itself extra privileges/ports/mounts for the next rebuild.
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspace/.devcontainer,type=bind,readonly",
    // Claude login, settings & sessions survive rebuilds (isolated per project)
    "source=reeky-horror-claude-${devcontainerId},target=/home/dev/.claude,type=volume",
    // Bash history
    "source=reeky-horror-history-${devcontainerId},target=/commandhistory,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
    // Optional telemetry off -> Datadog hosts don't need to be allowed
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    // claude.ai MCP connectors off -> mcp-proxy.anthropic.com stays closed
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "TZ": "Europe/Berlin"
  },
  "remoteEnv": {
    // Don't forward the host's SSH agent
    "SSH_AUTH_SOCK": ""
  },

  // ---------------------------------------------------------------------------
  //  Ports: Rojo only
  //  VS Code tunnels the port over its own connection (no `docker -p`);
  //  on the host it lands on localhost:34872 -> Roblox Studio Rojo plugin.
  // ---------------------------------------------------------------------------
  "forwardPorts": [34872],
  "portsAttributes": {
    "34872": {
      "label": "Rojo (Roblox Studio Sync)",
      "onAutoForward": "silent",
      "requireLocalPort": true
    }
  },
  // All other ports are NOT forwarded automatically
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },

  // ---------------------------------------------------------------------------
  //  Lifecycle
  // ---------------------------------------------------------------------------
  "postCreateCommand": "devcontainer-post-create",
  "postStartCommand": "firewall-wait 90",
  "waitFor": "postStartCommand",

  // ---------------------------------------------------------------------------
  //  VS Code
  // ---------------------------------------------------------------------------
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "evaera.vscode-rojo",
        "JohnnyMorganz.luau-lsp",
        "JohnnyMorganz.stylua",
        "Kampfkarren.selene-vscode"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n",
        "luau-lsp.sourcemap.enabled": true,
        "luau-lsp.sourcemap.autogenerate": true,
        "luau-lsp.platform.type": "roblox",
        "[luau]": {
          "editor.defaultFormatter": "JohnnyMorganz.stylua",
          "editor.formatOnSave": true
        },
        "[lua]": {
          "editor.defaultFormatter": "JohnnyMorganz.stylua",
          "editor.formatOnSave": true
        }
      }
    }
  }
}
